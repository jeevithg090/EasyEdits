# EasyEdits API server configuration. Copy to server/.env and fill in what you need.
# Every integration is optional: features whose keys are missing return a clear error.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3005
# Comma-separated list of allowed browser origins, or * to allow any origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Maximum JSON request body size
JSON_BODY_LIMIT=10mb

# ---------------------------------------------------------------------------
# Google Gemini (scripts, news, B-roll/music suggestions, image generation)
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional: extra keys to rotate through when one is rate limited
# GEMINI_API_KEYS=key-a,key-b
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# Optional: override the model ids
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------------------------------------------------------------------------
# OpenRouter (image prompts, content scripts, keyword extraction)
# https://openrouter.ai/settings/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Speechify text-to-speech (Text Highlighter voiceovers)
# https://console.sws.speechify.com
# ---------------------------------------------------------------------------
SPEECHIFY_API_KEY=

# ---------------------------------------------------------------------------
# Stock B-roll search
# ---------------------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Cloud processing (optional): Cloudflare R2 + Firebase Firestore job queue,
# processed by the Google Colab worker in colab/
# ---------------------------------------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=easy-edits-videos
# Public URL for the bucket if it is exposed through a custom domain
CLOUDFLARE_R2_PUBLIC_URL=

# Firebase service account: provide ONE of these, or place the file at
# server/firebase-service-account.json (git-ignored)
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
